# Copy to apps/api/.env (gitignored) and fill in only what you have.
# Every key is optional: without keys the API still runs end to end and
# falls back to fixtures, a Pillow renderer and an in-memory job store.

# Anthropic Claude (claude-haiku-4-5) - persona, palette, typography, voice,
# brand name, agency match reasons, creator recommendations
ANTHROPIC_API_KEY=

# Cloudflare Workers AI (FLUX.1 schnell) - logo, mockup and social images
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Supabase - job table + asset storage. Without these, jobs live in memory and
# images are served from apps/api/cache via /static. Schema: migrations.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Canva Connect - optional editable go-to-market kit
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_SOCIAL_TEMPLATE_IDS=
CANVA_MOCKUP_TEMPLATE_IDS=

# Demo cache: replay apps/api/cache/<handle>/result.json for this handle
CACHE_MODE=false
DEMO_HANDLE=

# Read by services via os.environ, so export these in your shell
# (they are not loaded from this file):
#   USE_STUBS=true            - run the whole pipeline on canned stub data
#   X_USERNAME / X_PASSWORD / X_EMAIL / X_EMAIL_PASSWORD - twscrape account for X scraping
